// ==UserScript==
// @name        Skip Prime Page on Amazon
// @namespace   Violentmonkey Scripts
// @match       https://www.amazon.ca/*
// @version     1.0
// ==/UserScript==

const skipPrimeLink = document.querySelector("#prime-decline-button");
if (skipPrimeLink) {
    skipPrimeLink.click();
}

(function() {
    'use strict';

    const totalPages = 190;

    function addPaginationElements(ul, currentPage) {
        let startPage = Math.max(2, currentPage - 4);
        let endPage = Math.min(totalPages - 1, currentPage + 4);

        if (currentPage <= 5) { startPage = 2; endPage = Math.min(9, totalPages - 1); }
        if (currentPage >= totalPages - 4) { startPage = Math.max(totalPages - 8, 2); endPage = totalPages - 1; }

        // Prev arrow
        const prevLi = document.createElement('li');
        // Note: Previous button has no class in native HTML
        const prevA = document.createElement('a');
        prevA.href = `/vine/vine-items?queue=encore&pn=&cn=&page=${Math.max(1, currentPage - 1)}`;
        prevA.innerHTML = '<span class="larr">←</span><span class="a-letter-space"></span><span class="a-letter-space"></span>Previous';
        prevLi.appendChild(prevA);
        ul.appendChild(prevLi);

        // First page
        const firstLi = document.createElement('li');
        firstLi.className = currentPage === 1 ? 'a-selected' : 'a-normal';
        const firstA = document.createElement('a');
        firstA.href = `/vine/vine-items?queue=encore&pn=&cn=&page=1`;
        firstA.textContent = '1';
        if (currentPage === 1) firstA.setAttribute('aria-current', 'page');
        firstLi.appendChild(firstA);
        ul.appendChild(firstLi);

        // Left ellipsis
        if (startPage > 2) {
            const ellipsisLi = document.createElement('li');
            ellipsisLi.className = 'a-disabled';
            ellipsisLi.setAttribute('aria-disabled', 'true');
            ellipsisLi.textContent = '...';
            ul.appendChild(ellipsisLi);
        }

        // Middle pages
        for (let i = startPage; i <= endPage; i++) {
            const li = document.createElement('li');
            li.className = i === currentPage ? 'a-selected' : 'a-normal';
            const a = document.createElement('a');
            a.href = `/vine/vine-items?queue=encore&pn=&cn=&page=${i}`;
            a.textContent = i;
            if (i === currentPage) a.setAttribute('aria-current', 'page');
            li.appendChild(a);
            ul.appendChild(li);
        }

        // Right ellipsis
        if (endPage < totalPages - 1) {
            const ellipsisLi = document.createElement('li');
            ellipsisLi.className = 'a-disabled';
            ellipsisLi.setAttribute('aria-disabled', 'true');
            ellipsisLi.textContent = '...';
            ul.appendChild(ellipsisLi);
        }

        // Last page
        const lastLi = document.createElement('li');
        lastLi.className = currentPage === totalPages ? 'a-selected' : 'a-normal';
        const lastA = document.createElement('a');
        lastA.href = `/vine/vine-items?queue=encore&pn=&cn=&page=${totalPages}`;
        lastA.textContent = totalPages;
        if (currentPage === totalPages) lastA.setAttribute('aria-current', 'page');
        lastLi.appendChild(lastA);
        ul.appendChild(lastLi);

        // Next arrow
        const nextLi = document.createElement('li');
        nextLi.className = 'a-last';  // Next button uses a-last class
        const nextA = document.createElement('a');
        nextA.href = `/vine/vine-items?queue=encore&pn=&cn=&page=${Math.min(totalPages, currentPage + 1)}`;
        nextA.innerHTML = 'Next<span class="a-letter-space"></span><span class="a-letter-space"></span><span class="larr">→</span>';
        nextLi.appendChild(nextA);
        ul.appendChild(nextLi);
    }

    function createPagination(currentPage, isTop = false) {
        // For top pagination, create just the ul element like the bottom one
        if (isTop) {
            const ul = document.createElement('ul');
            ul.className = 'a-pagination';
            ul.style.display = 'inline-block';
            ul.style.margin = '0px';
            ul.style.padding = '0px';
            return ul;
        }

        // For bottom pagination, keep the wrapper
        const wrapper = document.createElement('div');
        wrapper.style.textAlign = 'center';
        wrapper.style.margin = '10px 0';
        wrapper.style.width = '100%';
        wrapper.style.display = 'block';

        const ul = document.createElement('ul');
        ul.className = 'a-pagination';
        ul.style.display = 'inline-block';
        ul.style.margin = '0px';
        ul.style.padding = '0px';

        // Add pagination elements to the ul
        addPaginationElements(ul, currentPage);

        wrapper.appendChild(ul);
        return wrapper;
    }

    function enhancePagination() {
        const paginationBottom = document.querySelector('ul.a-pagination');
        if (!paginationBottom) return;

        const currentPageLi = paginationBottom.querySelector('li.a-selected a');
        if (!currentPageLi) return;
        const urlParams = new URLSearchParams(currentPageLi.href.split('?')[1]);
        const currentPage = parseInt(urlParams.get('page')) || 1;

        const newBottom = createPagination(currentPage, false);
        paginationBottom.replaceWith(newBottom);

        // Find the items grid and insert top pagination before it
        const itemsGrid = document.querySelector('#vvp-items-grid');
        if (itemsGrid) {
            // Create top pagination with exact same structure as bottom
            const newTopUl = createPagination(currentPage, true);

            // Add all the pagination elements to the ul
            addPaginationElements(newTopUl, currentPage);

            // Create a centered container for the top pagination (matching bottom)
            const topContainer = document.createElement('div');
            topContainer.style.textAlign = 'center';
            topContainer.style.margin = '10px 0px';
            topContainer.style.width = '100%';
            topContainer.style.display = 'block';
            topContainer.appendChild(newTopUl);

            // Insert before the items grid
            itemsGrid.parentNode.insertBefore(topContainer, itemsGrid);
        }
    }

    window.addEventListener('load', enhancePagination);
})();
